{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifecycle-spec.local/schemas/v0.1/release-candidate.json",
  "title": "Development Release Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "kind", "generatedAt", "requirement", "acceptanceCriteria", "tasks", "evidence", "sources", "readiness"],
  "properties": {
    "spec": {"const": "lifecycle-spec/release-candidate/v1"},
    "kind": {"const": "release-candidate"},
    "generatedAt": {"$ref": "defs.json#/$defs/rfc3339DateTime"},
    "requirement": {"$ref": "#/$defs/requirement"},
    "acceptanceCriteria": {"type": "array", "items": {"$ref": "#/$defs/criterion"}},
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/developmentEvidence"}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/sourceSnapshot"}},
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteriaTotal", "criteriaSatisfied", "tasksTotal", "tasksDone", "criteriaWithEvidence", "sourcesTotal", "sourcesClean", "ready"],
      "properties": {
        "criteriaTotal": {"type": "integer", "minimum": 0},
        "criteriaSatisfied": {"type": "integer", "minimum": 0},
        "tasksTotal": {"type": "integer", "minimum": 0},
        "tasksDone": {"type": "integer", "minimum": 0},
        "criteriaWithEvidence": {"type": "integer", "minimum": 0},
        "sourcesTotal": {"type": "integer", "minimum": 0},
        "sourcesClean": {"type": "integer", "minimum": 0},
        "ready": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "createdAt", "updatedAt"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "createdAt": {"$ref": "defs.json#/$defs/rfc3339DateTime"},
        "updatedAt": {"$ref": "defs.json#/$defs/rfc3339DateTime"}
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirementId", "description", "satisfied", "createdAt"],
      "properties": {
        "id": {"type": "string"},
        "requirementId": {"type": "string"},
        "description": {"type": "string", "minLength": 1},
        "satisfied": {"type": "boolean"},
        "createdAt": {"$ref": "defs.json#/$defs/rfc3339DateTime"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirementId", "title", "description", "status", "branch", "worktreePath", "createdAt", "updatedAt"],
      "properties": {
        "id": {"type": "string"},
        "requirementId": {"type": "string"},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "status": {"enum": ["todo", "in_progress", "done"]},
        "branch": {"type": "string"},
        "worktreePath": {"type": "string"},
        "dependsOn": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "createdAt": {"$ref": "defs.json#/$defs/rfc3339DateTime"},
        "updatedAt": {"$ref": "defs.json#/$defs/rfc3339DateTime"}
      }
    },
    "developmentEvidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "requirementId", "kind", "title", "status", "createdAt"],
      "properties": {
        "id": {"type": "string"},
        "requirementId": {"type": "string"},
        "criterionId": {"type": "string"},
        "taskId": {"type": "string"},
        "kind": {"type": "string"},
        "title": {"type": "string"},
        "status": {"enum": ["passed", "failed", "informational"]},
        "createdAt": {"$ref": "defs.json#/$defs/rfc3339DateTime"}
      }
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "taskTitle", "repositoryPath", "worktreePath", "branch", "headCommit", "clean", "dirtyFiles", "capturedAt"],
      "properties": {
        "taskId": {"type": "string", "minLength": 1},
        "taskTitle": {"type": "string"},
        "repositoryPath": {"type": "string", "minLength": 1},
        "worktreePath": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "headCommit": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
        "clean": {"type": "boolean"},
        "dirtyFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["xy", "path"],
            "properties": {"xy": {"type": "string"}, "path": {"type": "string"}}
          }
        },
        "capturedAt": {"$ref": "defs.json#/$defs/rfc3339DateTime"}
      }
    }
  }
}
