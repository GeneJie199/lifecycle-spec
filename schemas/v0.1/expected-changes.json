{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifecycle-spec.local/schemas/v0.1/expected-changes.json",
  "title": "Expected Changes",
  "description": "Versioned, reviewable declaration of the infrastructure, database, fleet, and topology changes expected from one release.",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "kind", "release_id", "version", "generated_at", "changes"],
  "properties": {
    "spec": {"const": "lifecycle-spec/expected-changes/v1"},
    "kind": {"const": "expected-changes"},
    "release_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "version": {"type": "string", "minLength": 1, "maxLength": 200},
    "generated_at": {"$ref": "defs.json#/$defs/rfc3339DateTime"},
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/expectedChange"}
    },
    "metadata": {
      "type": "object",
      "maxProperties": 100,
      "additionalProperties": {"type": "string", "maxLength": 1000}
    }
  },
  "$defs": {
    "boundedUniqueStrings": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 300}
    },
    "expectedChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "action", "resource_id", "summary"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 200},
        "source": {"enum": ["infrascout", "database", "fleet", "topology"]},
        "action": {"enum": ["added", "removed", "changed"]},
        "resource_id": {"type": "string", "minLength": 1, "maxLength": 1000},
        "resource_type": {"type": "string", "minLength": 1, "maxLength": 200},
        "node_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "fields": {"$ref": "#/$defs/boundedUniqueStrings"},
        "fingerprint": {"type": "string", "minLength": 1, "maxLength": 200},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2000},
        "evidence_ids": {"$ref": "#/$defs/boundedUniqueStrings"},
        "verification_checks": {"$ref": "#/$defs/boundedUniqueStrings"},
        "metric_policies": {"$ref": "#/$defs/boundedUniqueStrings"},
        "affected_nodes": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 300}
        },
        "required": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "database"}}, "required": ["source"]},
          "then": {"required": ["verification_checks"], "properties": {"verification_checks": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"source": {"enum": ["fleet", "topology"]}}, "required": ["source"]},
          "then": {
            "anyOf": [
              {"required": ["node_id"]},
              {"required": ["affected_nodes"], "properties": {"affected_nodes": {"minItems": 1}}}
            ]
          }
        }
      ]
    }
  }
}
