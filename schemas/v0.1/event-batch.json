{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifecycle-spec.local/schemas/v0.1/event-batch.json",
  "title": "Native Event Batch",
  "description": "Versioned transport contract for logs and operational events.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "node_id", "source", "sequence", "sent_at", "events"],
  "properties": {
    "schema": {"const": "event.batch/v1"},
    "node_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "source": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "sequence": {"type": "integer", "minimum": 0},
    "sent_at": {"$ref": "defs.json#/$defs/rfc3339DateTime"},
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {"$ref": "#/$defs/event"}
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "timestamp_ms", "kind", "severity", "message"],
      "properties": {
        "id": {"type": "string", "pattern": "^evt_[A-Za-z0-9._-]{8,76}$"},
        "timestamp_ms": {"type": "integer", "minimum": 0},
        "kind": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "severity": {"type": "string", "enum": ["debug", "info", "warning", "error", "critical"]},
        "service": {"type": "string", "maxLength": 200},
        "message": {"type": "string", "minLength": 1, "maxLength": 16384},
        "attributes": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "additionalProperties": {"type": "string", "maxLength": 1000}
        }
      }
    }
  }
}
