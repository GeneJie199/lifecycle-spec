{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifecycle-spec.local/schemas/v0.1/telemetry-batch.json",
  "title": "Native Telemetry Batch",
  "description": "Versioned transport contract for native and compatibility telemetry ingestion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "node_id", "source", "sequence", "sent_at", "points"],
  "properties": {
    "schema": {"const": "telemetry.batch/v1"},
    "node_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "source": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "sequence": {"type": "integer", "minimum": 0},
    "sent_at": {"$ref": "defs.json#/$defs/rfc3339DateTime"},
    "points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/point"}
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "timestamp_ms", "value"],
      "properties": {
        "metric": {"type": "string", "pattern": "^[A-Za-z_:][A-Za-z0-9_:.-]{0,199}$"},
        "labels": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$"},
          "additionalProperties": {"type": "string", "maxLength": 256}
        },
        "timestamp_ms": {"type": "integer", "minimum": 0},
        "value": {"type": "number"},
        "kind": {"type": "string", "enum": ["gauge", "counter"], "default": "gauge"},
        "unit": {"type": "string", "maxLength": 40}
      }
    }
  }
}
