{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifecycle-spec.local/schemas/v0.1/snapshot.json",
  "title": "Snapshot",
  "description": "Professional: Snapshot. Plain: a normalized photo of state used for diffs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["snapshotId", "capturedAt", "source", "resources"],
  "properties": {
    "specVersion": { "$ref": "defs.json#/$defs/specVersion" },
    "snapshotId": { "$ref": "defs.json#/$defs/snapshotId" },
    "capturedAt": { "$ref": "defs.json#/$defs/rfc3339DateTime" },
    "source": { "$ref": "defs.json#/$defs/source" },
    "context": { "$ref": "defs.json#/$defs/context" },
    "noisePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filteredFields": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Attribute paths excluded from comparison, e.g. attributes.pid"
        },
        "notes": { "type": "string" }
      }
    },
    "resources": {
      "type": "array",
      "items": { "$ref": "resource.json" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "relationship.json" }
    },
    "digest": { "$ref": "defs.json#/$defs/digest" }
  }
}
