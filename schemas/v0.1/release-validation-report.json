{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifecycle-spec.local/schemas/v0.1/release-validation-report.json",
  "title": "Release Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_id", "version", "decision", "decision_reason", "generated_at", "plan_sha256", "manifest", "results", "rollback"],
  "properties": {
    "schema_version": {"const": "releaseguard.report/v1"},
    "release_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "decision": {"enum": ["GO", "HOLD", "NO-GO"]},
    "decision_reason": {"type": "string"},
    "generated_at": {"$ref": "defs.json#/$defs/rfc3339DateTime"},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "manifest": {"$ref": "#/$defs/manifest"},
    "results": {"type": "array", "items": {"$ref": "#/$defs/result"}},
    "rollback": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "observation": {"$ref": "#/$defs/observationState"},
    "guidance": {"type": "array", "maxItems": 50, "items": {"$ref": "#/$defs/guidance"}}
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "phase", "status", "required", "summary", "duration_ms"],
      "properties": {
        "name": {"type": "string"},
        "type": {"type": "string"},
        "phase": {"enum": ["plan", "recovery", "delivery", "verification", "infrastructure", "changes", "observation", "internal"]},
        "status": {"enum": ["pass", "fail"]},
        "required": {"type": "boolean"},
        "summary": {"type": "string"},
        "duration_ms": {"type": "integer", "minimum": 0},
        "evidence": {"type": "object"}
      }
    },
    "metricWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "end_ms", "samples", "series", "value", "minimum", "maximum", "last"],
      "properties": {
        "start_ms": {"type": "integer"},
        "end_ms": {"type": "integer"},
        "samples": {"type": "integer", "minimum": 0},
        "series": {"type": "integer", "minimum": 0},
        "value": {"type": "number"},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "last": {"type": "number"}
      }
    },
    "metricEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "metric", "aggregate", "series_reduce", "direction", "pass", "summary"],
      "properties": {
        "name": {"type": "string"},
        "metric": {"type": "string"},
        "node": {"type": "string"},
        "aggregate": {"enum": ["avg", "min", "max", "last", "sum", "rate"]},
        "series_reduce": {"enum": ["avg", "min", "max", "last", "sum"]},
        "direction": {"enum": ["lower", "higher"]},
        "before": {"$ref": "#/$defs/metricWindow"},
        "after": {"$ref": "#/$defs/metricWindow"},
        "regression_percent": {"type": "number"},
        "pass": {"type": "boolean"},
        "summary": {"type": "string"}
      }
    },
    "nodeEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "health", "observed_at", "actual_version", "expected_version", "match"],
      "properties": {
        "node_id": {"type": "string"},
        "health": {"type": "string"},
        "observed_at": {"type": "string"},
        "actual_version": {"type": "string"},
        "expected_version": {"type": "string"},
        "match": {"type": "boolean"}
      }
    },
    "fleetEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked_at", "nodes", "critical_alerts"],
      "properties": {
        "checked_at": {"$ref": "defs.json#/$defs/rfc3339DateTime"},
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/nodeEvidence"}},
        "critical_alerts": {"type": "integer", "minimum": 0}
      }
    },
    "observationState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "started_at", "deadline_at", "samples"],
      "properties": {
        "status": {"enum": ["observing", "completed"]},
        "started_at": {"$ref": "defs.json#/$defs/rfc3339DateTime"},
        "deadline_at": {"$ref": "defs.json#/$defs/rfc3339DateTime"},
        "samples": {"type": "array", "items": {"$ref": "#/$defs/fleetEvidence"}}
      }
    },
    "observedChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "action", "resource_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {"enum": ["infrascout", "database", "fleet", "topology"]},
        "action": {"enum": ["added", "removed", "changed"]},
        "resource_id": {"type": "string", "minLength": 1},
        "resource_type": {"type": "string"},
        "node_id": {"type": "string"},
        "fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "fingerprint": {"type": "string"},
        "severity": {"type": "string"},
        "summary": {"type": "string"},
        "classification": {"type": "string"},
        "release_id": {"type": "string"}
      }
    },
    "changeSourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "checked_at", "items"],
      "properties": {
        "source": {"enum": ["infrascout", "database", "fleetscope", "topology"]},
        "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "checked_at": {"$ref": "defs.json#/$defs/rfc3339DateTime"},
        "items": {"type": "integer", "minimum": 0}
      }
    },
    "changeCorrelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_id", "status", "required"],
      "properties": {
        "expected_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["matched", "missing", "optional-missing", "ambiguous"]},
        "required": {"type": "boolean"},
        "observed_id": {"type": "string", "minLength": 1},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "changeCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec", "document_sha256", "declared", "observed", "sources", "correlations", "unexpected", "expected_total", "matched_total", "missing_required", "missing_optional", "unexpected_total"],
      "properties": {
        "spec": {"const": "lifecycle-spec/expected-changes/v1"},
        "document_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "declared": {"type": "array", "items": {"$ref": "expected-changes.json#/$defs/expectedChange"}},
        "observed": {"type": "array", "items": {"$ref": "#/$defs/observedChange"}},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/changeSourceEvidence"}},
        "correlations": {"type": "array", "items": {"$ref": "#/$defs/changeCorrelation"}},
        "unexpected": {"type": "array", "items": {"$ref": "#/$defs/observedChange"}},
        "expected_total": {"type": "integer", "minimum": 0},
        "matched_total": {"type": "integer", "minimum": 0},
        "missing_required": {"type": "integer", "minimum": 0},
        "missing_optional": {"type": "integer", "minimum": 0},
        "unexpected_total": {"type": "integer", "minimum": 0}
      }
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "priority", "title", "summary"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "priority": {"enum": ["blocking", "review", "next"]},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "related_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "manifest": {
      "type": "object",
      "required": ["release_id", "version", "created_at"],
      "properties": {
        "release_id": {"type": "string"},
        "version": {"type": "string"},
        "created_at": {"$ref": "defs.json#/$defs/rfc3339DateTime"},
        "metrics": {"type": "array", "items": {"$ref": "#/$defs/metricEvidence"}},
        "changes": {"$ref": "#/$defs/changeCoverage"}
      },
      "additionalProperties": true
    }
  }
}
